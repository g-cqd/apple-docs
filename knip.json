{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/**/*.js",
    "test/**/*.js",
    "scripts/**/*.js",
    "docs/.vitepress/config.mjs",
    "fuzz/fuzz-*.js"
  ],
  "project": [
    "src/**/*.js",
    "test/**/*.js",
    "scripts/**/*.js",
    "docs/.vitepress/**/*.{js,mjs}",
    "!test/fixtures/**",
    "fuzz/**/*.js"
  ],
  "ignoreDependencies": [
    "bun-types",
    "onnxruntime-node",
    "onnxruntime-web",
    "@jazzer.js/core"
  ]
}
