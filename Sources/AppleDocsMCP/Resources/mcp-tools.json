[
  {
    "name": "search_docs",
    "description": "Search Apple developer docs (keyword + semantic). Set read=true to inline the top hit.",
    "isAssetTool": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "Search terms, symbol name, path, or USR." },
        "framework": { "type": "string", "description": "Framework slug, e.g. swiftui." },
        "kind": { "type": "string", "description": "Page or symbol kind." },
        "language": { "type": "string", "enum": ["swift", "objc"] },
        "deprecated": { "type": "string", "enum": ["include", "exclude", "only"] },
        "source": { "type": "string", "description": "Comma-separated source slugs: apple-docc, hig, wwdc, ..." },
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "read": { "type": "boolean", "description": "Inline the top result's full content." },
        "minVersion": {
          "type": "object",
          "properties": {
            "ios": { "type": "string" },
            "macos": { "type": "string" },
            "watchos": { "type": "string" },
            "tvos": { "type": "string" },
            "visionos": { "type": "string" }
          }
        },
        "match": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "context": { "type": "integer", "minimum": 20, "maximum": 2000 },
            "max": { "type": "integer", "minimum": 1, "maximum": 50 },
            "caseSensitive": { "type": "boolean" }
          },
          "required": ["query"]
        },
        "maxChars": { "type": "integer", "minimum": 512, "maximum": 100000 },
        "page": { "type": "integer", "minimum": 1, "maximum": 10000 }
      },
      "required": ["query"]
    }
  },
  {
    "name": "read_doc",
    "description": "Read a documentation page as Markdown by path or symbol, with pagination, section, or match excerpts.",
    "isAssetTool": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "description": "Document key, e.g. swiftui/view." },
        "symbol": { "type": "string", "description": "Symbol name, e.g. NavigationStack." },
        "framework": { "type": "string", "description": "Disambiguates symbol." },
        "section": { "type": "string", "description": "Single section by heading." },
        "match": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "context": { "type": "integer", "minimum": 20, "maximum": 2000 },
            "max": { "type": "integer", "minimum": 1, "maximum": 50 },
            "caseSensitive": { "type": "boolean" }
          },
          "required": ["query"]
        },
        "maxChars": { "type": "integer", "minimum": 512, "maximum": 100000 },
        "page": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    }
  },
  {
    "name": "list_frameworks",
    "description": "List indexed documentation roots (frameworks, HIG, guidelines, WWDC, Swift book).",
    "isAssetTool": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "description": "Filter by root kind." }
      }
    }
  },
  {
    "name": "browse",
    "description": "Walk the documentation topic tree under a root slug or parent path.",
    "isAssetTool": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "framework": { "type": "string", "description": "Root slug, e.g. swiftui, design, wwdc." },
        "path": { "type": "string", "description": "Parent path prefix to drill into." },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 }
      },
      "required": ["framework"]
    }
  },
  {
    "name": "list_taxonomy",
    "description": "List distinct taxonomy values (kind, role, role_heading, source_type, framework) with counts.",
    "isAssetTool": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "field": { "type": "string", "enum": ["kind", "role", "role_heading", "source_type", "framework"] },
        "all": { "type": "boolean", "description": "Return full distribution instead of top 20." }
      }
    }
  },
  {
    "name": "search_sf_symbols",
    "description": "Search SF Symbols by name, category, alias, or keyword.",
    "isAssetTool": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "Name or keyword; empty lists all." },
        "scope": { "type": "string", "enum": ["public", "private"] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    }
  },
  {
    "name": "list_apple_fonts",
    "description": "List indexed Apple font families and font file IDs.",
    "isAssetTool": true,
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "render_sf_symbol",
    "description": "Render an SF Symbol to SVG with validated size, color, and background.",
    "isAssetTool": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "SF Symbol name, e.g. pencil.and.sparkles." },
        "scope": { "type": "string", "enum": ["public", "private"] },
        "size": { "type": "integer", "minimum": 8, "maximum": 1024 },
        "color": { "type": "string", "description": "Foreground hex or currentColor." },
        "background": { "type": "string", "description": "Background hex or transparent." }
      },
      "required": ["name"]
    }
  },
  {
    "name": "render_font_text",
    "description": "Render a text preview as SVG using an Apple font.",
    "isAssetTool": true,
    "inputSchema": {
      "type": "object",
      "properties": {
        "fontId": { "type": "string", "description": "Font file id from list_apple_fonts." },
        "text": { "type": "string", "description": "Text to render." },
        "size": { "type": "integer", "minimum": 8, "maximum": 512 }
      },
      "required": ["fontId"]
    }
  }
]
