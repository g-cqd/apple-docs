{
  "project": {
    "linux": true
  },
  "swift": {
    "versions": [
      "6.4.2"
    ],
    "parallel": true
  },
  "checks": {
    "macos-release": [
      "push",
      "pull-request",
      "merge-queue",
      "tag",
      "dispatch",
      "nightly"
    ]
  },
  "quality": {
    "paths": [
      "Sources"
    ],
    "analyzers": [
      "deadwood",
      "dolly",
      "arcleak",
      "fcheck",
      "modeler"
    ],
    "include": [
      "/Package.swift",
      "Sources/**",
      "Tests/**"
    ],
    "local": [
      "litmus"
    ],
    "discipline": {
      "shipped": [
        "Sources"
      ],
      "forceUnwrap": true,
      "rules": [
        "strtod",
        "inline-prng",
        "untyped-throws",
        "wall-clock"
      ]
    }
  },
  "release": {
    "executables": [
      "apple-docs"
    ],
    "notes": "docs/releases/{tag}.md",
    "noteStyle": "freeform",
    "appleSigning": {
      "sign": true,
      "identifier": "apple-docs",
      "hardenedRuntime": true,
      "notarize": true,
      "requireOnTag": true
    }
  },
  "commands": [
    {
      "id": "linux-system-packages",
      "title": "Setup · System Packages",
      "run": "apt-get update -qq && apt-get install -y -qq --no-install-recommends libsqlite3-dev > /dev/null",
      "before": [
        "linux-debug",
        "linux-release",
        "linux-address",
        "linux-thread"
      ]
    },
    {
      "id": "layer-guards",
      "title": "Quality · Layering & Scripts",
      "run": "command -v python3 > /dev/null || { apt-get update -qq && apt-get install -y -qq --no-install-recommends python3 > /dev/null; }; python3 -B Scripts/check-layers.py && python3 -B Scripts/test-layers.py",
      "os": "linux"
    },
    {
      "id": "dependency-audit",
      "title": "Quality · Declared Dependencies",
      "run": "Scripts/dependency-audit.sh",
      "os": "macOS"
    },
    {
      "id": "mutation",
      "title": "Verification · Mutation (litmus)",
      "os": "macOS",
      "cadence": [
        "nightly",
        "dispatch"
      ],
      "mutation": {
        "paths": [
          "Sources/AppleDocsCore/**",
          "Sources/AppleDocsOutput/**",
          "Sources/AppleDocsStorage/**",
          "Sources/AppleDocsSearch/**"
        ],
        "budget": 3600,
        "workspace": "copy"
      }
    },
    {
      "id": "fuzz",
      "title": "Verification · Fuzzing (libFuzzer + ASan)",
      "run": "Fuzz/ci.sh",
      "os": "linux",
      "cadence": [
        "nightly",
        "dispatch"
      ]
    },
    {
      "id": "benchmarks",
      "title": "Verification · Benchmarks (vs previous commit)",
      "os": "macOS",
      "cadence": [
        "push",
        "nightly"
      ],
      "paths": [
        "Sources/**",
        "Benchmarks/**"
      ],
      "benchmark": {
        "package": "Benchmarks",
        "metrics": [
          "instructions",
          "mallocCountTotal"
        ]
      }
    }
  ]
}
